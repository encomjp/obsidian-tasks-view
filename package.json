{
  "name": "obsidian-tasks-view",
  "version": "0.2.2",
  "description": "A task panel for Obsidian notes: Today, Upcoming and Inbox views, filters, grouping, recurring tasks and reminders. Ported from Starnote.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "obsidian",
    "tasks",
    "todo",
    "recurring",
    "reminders"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  },
  "author": "encomjp"
}
